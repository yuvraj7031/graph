//Maximum Subarray sum <=k with negatives number//
//Uses TreeSet finding it efficeintly
import java.util.*;
class Main {
    static int maxSubarraySum(int[] nums, int k) {
        TreeSet<Long> set = new TreeSet<>();

        long prefix = 0;
        long ans = Long.MIN_VALUE;

        set.add(0L);

        for (int x : nums) {
            prefix += x;

            // smallest previous prefix >= prefix - k
            Long prev = set.ceiling(prefix - k);

            if (prev != null) {
                ans = Math.max(ans, prefix - prev);
            }

            set.add(prefix);
        }

        return (int) ans;
    }

    public static void main(String[] args) {
        int[] nums = {2, -1, 3, -2, 4};
        int k = 4;

        System.out.println(maxSubarraySum(nums, k));
    }
}
